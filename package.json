{
  "name": "contentsynergy-ai-docs",
  "version": "0.1.0",
  "private": true,
  "description": "Public documentation for ContentSynergy AI, built with Docusaurus and deployed through GitHub Pages.",
  "author": {
    "name": "Ahsan Mahmood",
    "email": "aoneahsan@gmail.com",
    "url": "https://aoneahsan.com"
  },
  "license": "MIT",
  "homepage": "https://contentsynergy-docs.aoneahsan.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aoneahsan/contentsynergy-ai-docs.git"
  },
  "engines": {
    "node": ">=24.13.0"
  },
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "docusaurus start --port 5962 --host 0.0.0.0",
    "build": "docusaurus build",
    "swizzle": "docusaurus swizzle",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve --port 5963",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "typecheck": "tsc --noEmit",
    "dev": "docusaurus start --port 5962 --host 0.0.0.0",
    "gates": "yarn typecheck && yarn build",
    "deps:outdated": "yarn dlx npm-check-updates@latest --reject typescript",
    "deps:update": "yarn dlx npm-check-updates@latest -u --reject typescript && yarn install"
  },
  "dependencies": {
    "@docusaurus/core": "^3.10.2",
    "@docusaurus/plugin-content-docs": "^3.10.2",
    "@docusaurus/preset-classic": "^3.10.2",
    "@docusaurus/theme-mermaid": "^3.10.2",
    "@mdx-js/react": "^3.1.1",
    "clsx": "^2.1.1",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@docusaurus/faster": "^3.10.2",
    "@docusaurus/module-type-aliases": "^3.10.2",
    "@docusaurus/tsconfig": "^3.10.2",
    "@docusaurus/types": "^3.10.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "~6.0.3"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "packageManager": "yarn@4.18.1"
}
